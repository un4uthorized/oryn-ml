// if is an expression, so its result can be bound or returned.
fn classify(n: Int) -> String {
    if n < 0 { "negative" } else {
        if n == 0 { "zero" } else { "positive" }
    }
}

let temperature = 24;
let pleasant = temperature >= 18 && temperature <= 26;

println(classify(-3));
println(classify(0));
println(classify(7));
println(if pleasant { "pleasant" } else { "uncomfortable" });
assert(!(false || !true));

